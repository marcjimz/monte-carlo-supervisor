{
  "datasets": [
    {
      "displayName": "Billing & Encounters",
      "name": "ds_billing",
      "query": "SELECT\n  encounter_id,\n  patient_id,\n  paid_amount,\n  total_charges,\n  claim_status,\n  encounter_type,\n  department,\n  admission_date,\n  COALESCE(primary_icd10_code, 'N/A') AS icd10_code\nFROM __CATALOG__.__SCHEMA__.v_wh_billing_encounters"
    },
    {
      "displayName": "Diagnoses",
      "name": "ds_diagnoses",
      "query": "SELECT\n  encounter_id,\n  patient_id,\n  department,\n  admission_date,\n  icd10_code,\n  diagnosis_description,\n  COALESCE(diagnosis_category, 'Other') AS diagnosis_category\nFROM __CATALOG__.__SCHEMA__.v_wh_encounter_diagnoses"
    },
    {
      "displayName": "Patient Demographics",
      "name": "ds_patients",
      "query": "SELECT\n  encounter_id,\n  patient_id,\n  department,\n  admission_date,\n  insurance_type,\n  CASE\n    WHEN FLOOR(DATEDIFF(admission_date, date_of_birth) / 365.25) < 35 THEN '18-34'\n    WHEN FLOOR(DATEDIFF(admission_date, date_of_birth) / 365.25) < 50 THEN '35-49'\n    WHEN FLOOR(DATEDIFF(admission_date, date_of_birth) / 365.25) < 65 THEN '50-64'\n    ELSE '65+'\n  END AS age_group,\n  CASE WHEN num_chronic > 0 THEN 'Chronic' ELSE 'Non-Chronic' END AS chronic_flag\nFROM __CATALOG__.__SCHEMA__.v_wh_encounter_patients"
    },
    {
      "displayName": "Top 15 Diagnoses",
      "name": "ds_diagnosis_top",
      "query": "SELECT\n  icd10_code,\n  COALESCE(diagnosis_description, icd10_code) AS description,\n  COUNT(*) AS diagnosis_count,\n  COUNT(DISTINCT patient_id) AS patient_count\nFROM __CATALOG__.__SCHEMA__.v_wh_encounter_diagnoses\nGROUP BY icd10_code, diagnosis_description\nORDER BY diagnosis_count DESC\nLIMIT 15"
    },
    {
      "displayName": "Simulation Runs",
      "name": "ds_sim_runs",
      "query": "SELECT\n  run_id,\n  simulation_type,\n  status,\n  num_simulations,\n  seed,\n  created_at,\n  updated_at\nFROM __CATALOG__.__SCHEMA__.simulation_runs\nORDER BY created_at DESC\nLIMIT 20"
    },
    {
      "displayName": "Simulation Results",
      "name": "ds_sim_results",
      "query": "SELECT\n  r.metric_name,\n  r.group_value,\n  r.mean_value,\n  r.p05,\n  r.p25,\n  r.p50,\n  r.p75,\n  r.p95,\n  r.num_trials,\n  s.simulation_type\nFROM __CATALOG__.__SCHEMA__.simulation_results r\nJOIN __CATALOG__.__SCHEMA__.simulation_runs s\n  ON r.run_id = s.run_id\nWHERE s.status = 'COMPLETED'\nORDER BY s.created_at DESC, r.metric_name\nLIMIT 100"
    },
    {
      "displayName": "Cost Detail",
      "name": "ds_cost_detail",
      "query": "SELECT\n  department,\n  encounter_type,\n  COALESCE(primary_icd10_code, 'N/A') AS icd10_code,\n  COUNT(*) AS encounters,\n  ROUND(SUM(paid_amount), 2) AS total_paid,\n  ROUND(AVG(paid_amount), 2) AS avg_paid,\n  ROUND(SUM(total_charges), 2) AS total_charges,\n  ROUND(SUM(CASE WHEN claim_status = 'Denied' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 1) AS denial_pct\nFROM __CATALOG__.__SCHEMA__.v_wh_billing_encounters\nGROUP BY department, encounter_type, primary_icd10_code\nORDER BY total_paid DESC"
    }
  ],
