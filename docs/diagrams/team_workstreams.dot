digraph TeamWorkstreams {
    rankdir=TB;
    fontname="Helvetica";
    bgcolor="white";
    compound=true;
    ranksep=1.0;
    nodesep=0.6;

    // Global edge styling
    edge [color="#555555", penwidth=1.5, fontname="Helvetica", fontsize=10, fontcolor="#333333"];

    // ===================================================================
    // PHASE 1 — Foundation (Parallel Workstreams)
    // ===================================================================
    subgraph cluster_phase1 {
        label="PHASE 1  —  Foundation (Parallel Workstreams)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#1B6ACB";
        color="#14508F";
        penwidth=2;

        // ---------------------------------------------------------------
        // WORKSTREAM 1: DATA MODELING
        // ---------------------------------------------------------------
        subgraph cluster_w1 {
            label="Data Modeling";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#EBF5FF";
            color="#1B6ACB";
            penwidth=2;

            w1_header [label="Data Tables + Semantics", shape=box, style="filled,rounded", fillcolor="#1B6ACB", fontcolor="white", fontname="Helvetica", fontsize=11, color="#14508F", penwidth=1.5, width=3];

            w1_t1 [label="12 Hospital Tables\n(Delta Lake)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];
            w1_t2 [label="6 UC Metric Views\n(Semantic Layer)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];
            w1_t3 [label="Data Quality,\nGovernance + RLS/CLM", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];

            w1_skills [label="Skills: PySpark, Delta Lake,\nUnity Catalog, SQL", shape=box, style="filled,rounded", fillcolor="#D6EAFF", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#1B6ACB", penwidth=1];

            w1_header -> w1_t1 [style=invis];
            w1_header -> w1_t2 [style=invis];
            w1_header -> w1_t3 [style=invis];
            w1_t1 -> w1_skills [style=invis];
        }

        // ---------------------------------------------------------------
        // WORKSTREAM 2: MONTE CARLO / SIMULATION ENGINE
        // ---------------------------------------------------------------
        subgraph cluster_w2 {
            label="Monte Carlo Engine";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#FFF8EB";
            color="#E8820C";
            penwidth=2;

            w2_header [label="Simulation Engine + UC Functions", shape=box, style="filled,rounded", fillcolor="#E8820C", fontcolor="white", fontname="Helvetica", fontsize=11, color="#B86709", penwidth=1.5, width=3];

            w2_t1 [label="5 Simulation Models\n(applyInPandas)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];
            w2_t2 [label="Distribution Fitting\n(scipy + Delta)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];
            w2_t3 [label="UC Functions\n(trigger, check, list_dists)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];

            w2_skills [label="Skills: Python, NumPy, SciPy,\nPySpark, UC Functions", shape=box, style="filled,rounded", fillcolor="#FFF0D6", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#E8820C", penwidth=1];

            w2_header -> w2_t1 [style=invis];
            w2_header -> w2_t2 [style=invis];
            w2_header -> w2_t3 [style=invis];
            w2_t1 -> w2_skills [style=invis];
        }

        // ---------------------------------------------------------------
        // WORKSTREAM 3: GENIE SPACE
        // ---------------------------------------------------------------
        subgraph cluster_w3 {
            label="Genie Space";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#FFF0EB";
            color="#FF3621";
            penwidth=2;

            w3_header [label="QnA on Women's Health Data", shape=box, style="filled,rounded", fillcolor="#FF3621", fontcolor="white", fontname="Helvetica", fontsize=11, color="#CC2A1A", penwidth=1.5, width=3];

            w3_t1 [label="Genie Space\nConfiguration", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];
            w3_t2 [label="Sample Questions\n+ Instructions", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];
            w3_t3 [label="AI/BI Dashboard\n(Lakeview)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];

            w3_skills [label="Skills: SQL, Genie API,\nLakeview Dashboards", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#FF3621", penwidth=1];

            w3_header -> w3_t1 [style=invis];
            w3_header -> w3_t2 [style=invis];
            w3_header -> w3_t3 [style=invis];
            w3_t1 -> w3_skills [style=invis];
        }
    }

    // ===================================================================
    // PHASE 2 — AgentBricks Supervisor
    // ===================================================================
    subgraph cluster_phase2 {
        label="PHASE 2  —  Orchestration (AgentBricks Supervisor)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#2D8C3C";
        color="#1E6128";
        penwidth=2;

        subgraph cluster_w4 {
            label="Multi-Agent Supervisor";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#F0F7EB";
            color="#2D8C3C";
            penwidth=2;

            w4_header [label="AgentBricks MAS  —  Orchestrate Phase 1 Components", shape=box, style="filled,rounded", fillcolor="#2D8C3C", fontcolor="white", fontname="Helvetica", fontsize=11, color="#1E6128", penwidth=1.5, width=5.5];

            w4_t1 [label="Supervisor Router\n(Intent Classification)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            w4_t2 [label="4 Sub-Agents\n(Genie, Checker, Trigger,\nDistribution Catalog)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            w4_t3 [label="Model Serving\nEndpoint", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            w4_t4 [label="UC HTTP Connection\n+ Secrets", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];

            w4_skills [label="Skills: Agent Bricks, UC Functions,\nUC Connections, REST APIs, Databricks Jobs", shape=box, style="filled,rounded", fillcolor="#DFF0D8", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#2D8C3C", penwidth=1, width=5.5];

            w4_header -> w4_t1 [style=invis];
            w4_header -> w4_t2 [style=invis];
            w4_header -> w4_t3 [style=invis];
            w4_header -> w4_t4 [style=invis];
            w4_t1 -> w4_skills [style=invis];
        }
    }

    // ===================================================================
    // PHASE 3 — Unified Experience
    // ===================================================================
    subgraph cluster_phase3 {
        label="PHASE 3  —  Unified Experience (Application Layer)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#7B3FA0";
        color="#5C2D80";
        penwidth=2;

        subgraph cluster_w5 {
            label="Databricks App";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#F5EEFA";
            color="#7B3FA0";
            penwidth=2;

            w5_header [label="Unified Experience  —  Workflows, Collaboration, Analysis", shape=box, style="filled,rounded", fillcolor="#7B3FA0", fontcolor="white", fontname="Helvetica", fontsize=11, color="#5C2D80", penwidth=1.5, width=5.5];

            w5_t1 [label="React SPA\n(FastAPI Backend)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            w5_t2 [label="Agent Chat\n(SSE Streaming to MAS)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            w5_t3 [label="Embedded Dashboards\n+ Genie Space", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            w5_t4 [label="Analysis Workflows\n(Share, Matrices, Simulations)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];

            w5_skills [label="Skills: React, TypeScript, FastAPI,\nLakebase (Postgres), Databricks Apps SDK", shape=box, style="filled,rounded", fillcolor="#E8D5F5", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#7B3FA0", penwidth=1, width=5.5];

            w5_header -> w5_t1 [style=invis];
            w5_header -> w5_t2 [style=invis];
            w5_header -> w5_t3 [style=invis];
            w5_header -> w5_t4 [style=invis];
            w5_t1 -> w5_skills [style=invis];
        }
    }

    // ===================================================================
    // DEPENDENCY EDGES between phases
    // ===================================================================
    w1_skills -> w4_header [color="#1B6ACB", penwidth=2.5, label="  tables + semantics ready  ", lhead=cluster_w4, ltail=cluster_w1, style=bold];
    w2_skills -> w4_header [color="#E8820C", penwidth=2.5, label="  engine + UC functions ready  ", lhead=cluster_w4, ltail=cluster_w2, style=bold];
    w3_skills -> w4_header [color="#FF3621", penwidth=2.5, label="  Genie Space ready  ", lhead=cluster_w4, ltail=cluster_w3, style=bold];

    w4_skills -> w5_header [color="#2D8C3C", penwidth=2.5, label="  MAS endpoint live  ", lhead=cluster_w5, ltail=cluster_w4, style=bold];
}
