digraph TeamWorkstreams {
    rankdir=TB;
    fontname="Helvetica";
    bgcolor="white";
    compound=true;
    ranksep=1.0;
    nodesep=0.6;

    // Global edge styling
    edge [color="#555555", penwidth=1.5, fontname="Helvetica", fontsize=10, fontcolor="#333333"];

    // ===================================================================
    // PHASE LABELS
    // ===================================================================
    subgraph cluster_phase1 {
        label="PHASE 1  —  Foundation (Parallel Workstreams)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#1B6ACB";
        color="#14508F";
        penwidth=2;

        // ---------------------------------------------------------------
        // GROUP 1: DATA ENGINEERING
        // ---------------------------------------------------------------
        subgraph cluster_g1 {
            label="Group 1: Data Engineering";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#EBF5FF";
            color="#1B6ACB";
            penwidth=2;

            g1_header [label="Owns: Raw Data Foundation", shape=box, style="filled,rounded", fillcolor="#1B6ACB", fontcolor="white", fontname="Helvetica", fontsize=11, color="#14508F", penwidth=1.5, width=3];

            g1_t1 [label="Synthetic data\ngeneration + loading", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];
            g1_t2 [label="Delta Lake table\ndesign (12 tables)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];
            g1_t3 [label="Data quality\nand governance", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1];

            g1_skills [label="Skills: PySpark, Delta Lake,\nUnity Catalog, NumPy", shape=box, style="filled,rounded", fillcolor="#D6EAFF", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#1B6ACB", penwidth=1];

            g1_header -> g1_t1 [style=invis];
            g1_header -> g1_t2 [style=invis];
            g1_header -> g1_t3 [style=invis];
            g1_t1 -> g1_skills [style=invis];
        }

        // ---------------------------------------------------------------
        // GROUP 2: ANALYTICS ENGINEERING
        // ---------------------------------------------------------------
        subgraph cluster_g2 {
            label="Group 2: Analytics Engineering";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#FFF0EB";
            color="#FF3621";
            penwidth=2;

            g2_header [label="Owns: Semantic Layer + Genie", shape=box, style="filled,rounded", fillcolor="#FF3621", fontcolor="white", fontname="Helvetica", fontsize=11, color="#CC2A1A", penwidth=1.5, width=3];

            g2_t1 [label="UC Metric Views\n(6 semantic views)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];
            g2_t2 [label="Genie Space\nconfiguration", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];
            g2_t3 [label="Sample questions\nand instructions", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1];

            g2_skills [label="Skills: SQL, UC Metric Views,\nGenie API", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#FF3621", penwidth=1];

            g2_header -> g2_t1 [style=invis];
            g2_header -> g2_t2 [style=invis];
            g2_header -> g2_t3 [style=invis];
            g2_t1 -> g2_skills [style=invis];
        }

        // ---------------------------------------------------------------
        // GROUP 3: SIMULATION ENGINEERING
        // ---------------------------------------------------------------
        subgraph cluster_g3 {
            label="Group 3: Simulation Engineering";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#FFF8EB";
            color="#E8820C";
            penwidth=2;

            g3_header [label="Owns: MC Engine + Models", shape=box, style="filled,rounded", fillcolor="#E8820C", fontcolor="white", fontname="Helvetica", fontsize=11, color="#B86709", penwidth=1.5, width=3];

            g3_t1 [label="Monte Carlo engine\n(applyInPandas)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];
            g3_t2 [label="5 simulation models\n(volume, revenue, LOS...)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];
            g3_t3 [label="Bronze-to-Gold\naggregation pipeline", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#E8820C", penwidth=1];

            g3_skills [label="Skills: Python, NumPy,\nPySpark, Statistics", shape=box, style="filled,rounded", fillcolor="#FFF0D6", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#E8820C", penwidth=1];

            g3_header -> g3_t1 [style=invis];
            g3_header -> g3_t2 [style=invis];
            g3_header -> g3_t3 [style=invis];
            g3_t1 -> g3_skills [style=invis];
        }
    }

    // ===================================================================
    // PHASE 2
    // ===================================================================
    subgraph cluster_phase2 {
        label="PHASE 2  —  Integration (Depends on Phase 1)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#2D8C3C";
        color="#1E6128";
        penwidth=2;

        // ---------------------------------------------------------------
        // GROUP 4: PLATFORM / INTEGRATION
        // ---------------------------------------------------------------
        subgraph cluster_g4 {
            label="Group 4: Platform / Integration Engineering";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#F0F7EB";
            color="#2D8C3C";
            penwidth=2;

            g4_header [label="Owns: Glue Layer — Functions, Auth, Supervisor", shape=box, style="filled,rounded", fillcolor="#2D8C3C", fontcolor="white", fontname="Helvetica", fontsize=11, color="#1E6128", penwidth=1.5, width=5.5];

            g4_t1 [label="UC Functions\n(check + trigger)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            g4_t2 [label="UC HTTP Connection\n+ Secrets", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            g4_t3 [label="Agent Bricks\nMAS Config", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
            g4_t4 [label="Model Serving\nEndpoint", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];

            g4_skills [label="Skills: SQL UDFs, http_request, Agent Bricks,\nUC Connections, REST APIs, Databricks Jobs", shape=box, style="filled,rounded", fillcolor="#DFF0D8", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#2D8C3C", penwidth=1, width=5.5];

            g4_header -> g4_t1 [style=invis];
            g4_header -> g4_t2 [style=invis];
            g4_header -> g4_t3 [style=invis];
            g4_header -> g4_t4 [style=invis];
            g4_t1 -> g4_skills [style=invis];
        }
    }

    // ===================================================================
    // PHASE 3
    // ===================================================================
    subgraph cluster_phase3 {
        label="PHASE 3  —  Experience (Depends on Phase 2)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=16;
        fontcolor="#FFFFFF";
        style="filled,rounded";
        fillcolor="#7B3FA0";
        color="#5C2D80";
        penwidth=2;

        // ---------------------------------------------------------------
        // GROUP 5: APP / FRONTEND
        // ---------------------------------------------------------------
        subgraph cluster_g5 {
            label="Group 5: App / Frontend Development";
            labeljust=l;
            fontname="Helvetica";
            fontsize=13;
            fontcolor="#333333";
            style="filled,rounded";
            fillcolor="#F5EEFA";
            color="#7B3FA0";
            penwidth=2;

            g5_header [label="Owns: End-User Experiences", shape=box, style="filled,rounded", fillcolor="#7B3FA0", fontcolor="white", fontname="Helvetica", fontsize=11, color="#5C2D80", penwidth=1.5, width=4.5];

            g5_t1 [label="AI Playground\ntesting + validation", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            g5_t2 [label="Custom Web App\n(React / Streamlit)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            g5_t3 [label="Slack Bot\nIntegration", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];
            g5_t4 [label="REST API\nConsumers", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#7B3FA0", penwidth=1];

            g5_skills [label="Skills: React, Python, Slack API,\nDatabricks Apps SDK", shape=box, style="filled,rounded", fillcolor="#E8D5F5", fontname="Helvetica", fontsize=9, fontcolor="#555555", color="#7B3FA0", penwidth=1, width=4.5];

            g5_header -> g5_t1 [style=invis];
            g5_header -> g5_t2 [style=invis];
            g5_header -> g5_t3 [style=invis];
            g5_header -> g5_t4 [style=invis];
            g5_t1 -> g5_skills [style=invis];
        }
    }

    // ===================================================================
    // DEPENDENCY EDGES between phases
    // ===================================================================
    g1_skills -> g4_header [color="#1B6ACB", penwidth=2.5, label="  tables ready  ", lhead=cluster_g4, ltail=cluster_g1, style=bold];
    g2_skills -> g4_header [color="#FF3621", penwidth=2.5, label="  Genie + views ready  ", lhead=cluster_g4, ltail=cluster_g2, style=bold];
    g3_skills -> g4_header [color="#E8820C", penwidth=2.5, label="  engine + models ready  ", lhead=cluster_g4, ltail=cluster_g3, style=bold];

    g4_skills -> g5_header [color="#2D8C3C", penwidth=2.5, label="  MAS endpoint live  ", lhead=cluster_g5, ltail=cluster_g4, style=bold];
}
