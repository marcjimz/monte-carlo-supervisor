digraph HospitalMCArchitecture {
    rankdir=TB;
    fontname="Helvetica";
    bgcolor="white";
    compound=true;
    newrank=true;
    ranksep=0.8;
    nodesep=0.5;

    // Global edge styling
    edge [color="#555555", penwidth=1.5, fontname="Helvetica", fontsize=10, fontcolor="#333333"];

    // ===================================================================
    // APPLICATION LAYER (Phase 3)
    // ===================================================================
    subgraph cluster_app {
        label="Application Layer  (Databricks App)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#333333";
        style="filled,rounded";
        fillcolor="#F5EEFA";
        color="#7B3FA0";
        penwidth=2;

        webapp [label="React SPA\n(Analyses, Matrices,\nSimulation Builder)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#7B3FA0", fontname="Helvetica", fontsize=10, fontcolor="#333333", penwidth=1.5];
        dashboard_embed [label="AI/BI Dashboard\n(Lakeview Embed)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#7B3FA0", fontname="Helvetica", fontsize=10, fontcolor="#333333", penwidth=1.5];
        genie_embed [label="Genie Space\n(Embedded Chat)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#7B3FA0", fontname="Helvetica", fontsize=10, fontcolor="#333333", penwidth=1.5];
        agent_chat [label="Agent Chat\n(SSE Streaming)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#7B3FA0", fontname="Helvetica", fontsize=10, fontcolor="#333333", penwidth=1.5];
        fastapi [label="FastAPI Backend\n(CRUD + Proxy)", shape=box, style="filled,rounded", fillcolor="#7B3FA0", fontcolor="white", fontname="Helvetica", fontsize=11, color="#5C2D80", penwidth=1.5];
        lakebase [label="Lakebase (Postgres)\n(Analyses, Threads, Matrices)", shape=cylinder, style=filled, fillcolor="#E8D5F5", fontname="Helvetica", fontsize=9, fontcolor="#333333", color="#7B3FA0", penwidth=1];

        webapp -> fastapi [color="#7B3FA0", penwidth=1];
        dashboard_embed -> fastapi [color="#7B3FA0", penwidth=1, style=invis];
        genie_embed -> fastapi [color="#7B3FA0", penwidth=1, style=invis];
        agent_chat -> fastapi [color="#7B3FA0", penwidth=1];
        fastapi -> lakebase [color="#7B3FA0", penwidth=1];
    }

    // ===================================================================
    // MODEL SERVING ENDPOINT
    // ===================================================================
    endpoint [label="Model Serving Endpoint  (MAS REST API)", shape=box, style="filled,rounded", fillcolor="#FF3621", fontcolor="white", fontname="Helvetica", fontsize=12, color="#CC2A1A", penwidth=2, width=4, height=0.6];

    // ===================================================================
    // ORCHESTRATION LAYER (Phase 2)
    // ===================================================================
    subgraph cluster_orchestration {
        label="Orchestration Layer  —  AgentBricks Multi-Agent Supervisor";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#333333";
        style="filled,rounded";
        fillcolor="#FFF0EB";
        color="#FF3621";
        penwidth=2;

        router [label="Supervisor Router\n(Intent Classification)", shape=box, style="filled,rounded", fillcolor="#FF6B4F", fontcolor="white", fontname="Helvetica", fontsize=11, color="#CC2A1A", penwidth=1.5];

        encounter_agent [label="encounter_analytics\n(Genie Sub-Agent)", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1.5];
        checker_agent [label="simulation_checker\n(check_simulation)", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1.5];
        trigger_agent [label="simulation_trigger\n(trigger_simulation)", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1.5];
        distribution_agent [label="distribution_catalog\n(list_distributions)", shape=box, style="filled,rounded", fillcolor="#FFE0D9", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#FF3621", penwidth=1.5];
    }

    // ===================================================================
    // AGENTIC LAYER (Phase 4 — Future)
    // ===================================================================
    subgraph cluster_agentic {
        label="Agentic Layer  —  Autonomous Model Building  (Future)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#555555";
        style="dashed,rounded";
        fillcolor="#E0F2F1";
        color="#00796B";
        penwidth=2;

        python_exec [label="Python Execution\n(Serverless Compute)", shape=box, style="filled,dashed,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#00796B", penwidth=1.5];
        mcp_tools [label="MCP Tools\n(Data Reading + APIs)", shape=box, style="filled,dashed,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#00796B", penwidth=1.5];
        model_builder [label="Model Builder\n(Fit + Register New\nModels & Distributions)", shape=box, style="filled,dashed,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#00796B", penwidth=1.5];
    }

    // ===================================================================
    // ANALYTICS LAYER (Phase 1)
    // ===================================================================
    subgraph cluster_analytics {
        label="Analytics Layer  (Genie + Semantic)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#333333";
        style="filled,rounded";
        fillcolor="#EBF5FF";
        color="#1B6ACB";
        penwidth=2;

        genie [label="Genie Space\n(Women's Health Analytics)", shape=box, style="filled,rounded", fillcolor="#1B6ACB", fontcolor="white", fontname="Helvetica", fontsize=11, color="#14508F", penwidth=1.5];

        metricviews [label="6 UC Metric Views\n(Semantic Layer)", shape=box, style="filled,rounded", fillcolor="#D6EAFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#1B6ACB", penwidth=1.5];

        genie -> metricviews [color="#1B6ACB", penwidth=1];
    }

    // ===================================================================
    // SIMULATION LAYER (Phase 1)
    // ===================================================================
    subgraph cluster_simulation {
        label="Simulation Layer  (MC Engine + UC Functions)";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#333333";
        style="filled,rounded";
        fillcolor="#FFF8EB";
        color="#E8820C";
        penwidth=2;

        subgraph cluster_ucfuncs {
            label="UC Functions";
            fontname="Helvetica";
            fontsize=10;
            fontcolor="#555555";
            style="filled,rounded";
            fillcolor="#FFF0D6";
            color="#E8820C";
            penwidth=1;

            check_fn [label="check_simulation\n(Cache Lookup)", shape=box, style="filled,rounded", fillcolor="#E8820C", fontcolor="white", fontname="Helvetica", fontsize=10, color="#B86709", penwidth=1.5];
            trigger_fn [label="trigger_simulation\n(HTTP Connection)", shape=box, style="filled,rounded", fillcolor="#E8820C", fontcolor="white", fontname="Helvetica", fontsize=10, color="#B86709", penwidth=1.5];
            list_dist_fn [label="list_distributions\n(Fitted Specs)", shape=box, style="filled,rounded", fillcolor="#E8820C", fontcolor="white", fontname="Helvetica", fontsize=10, color="#B86709", penwidth=1.5];
        }

        subgraph cluster_pipeline {
            label="Databricks Job: monte_carlo_pipeline";
            fontname="Helvetica";
            fontsize=10;
            fontcolor="#555555";
            style="filled,rounded";
            fillcolor="#FFF0D6";
            color="#E8820C";
            penwidth=1;

            task1 [label="1. Validate\n+ Resolve Dists", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=9, fontcolor="#333333", color="#E8820C", penwidth=1];
            task2 [label="2. Spark MC\n(applyInPandas)", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=9, fontcolor="#333333", color="#E8820C", penwidth=1];
            task3 [label="3. Aggregate\nBronze to Gold", shape=box, style="filled,rounded", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=9, fontcolor="#333333", color="#E8820C", penwidth=1];
        }
    }

    // ===================================================================
    // DATA LAYER (Phase 1)
    // ===================================================================
    subgraph cluster_data {
        label="Data Layer  —  Unity Catalog + Delta Lake";
        labeljust=l;
        fontname="Helvetica";
        fontsize=14;
        fontcolor="#333333";
        style="filled,rounded";
        fillcolor="#F0F7EB";
        color="#2D8C3C";
        penwidth=2;

        hospital_tables [label="12 Hospital Tables\n(patients, encounters, billing, ...)", shape=cylinder, style=filled, fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1.5];
        dist_specs [label="distribution_specs\n(Fitted Distributions)", shape=cylinder, style=filled, fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];

        sim_runs [label="simulation_runs\n(Metadata + Cache)", shape=cylinder, style=filled, fillcolor="#FFFFFF", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#2D8C3C", penwidth=1];
        sim_trials [label="simulation_trials\n(Bronze)", shape=cylinder, style=filled, fillcolor="#FFF2CC", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#CD7F32", penwidth=1.5];
        sim_results [label="simulation_results\n(Gold)", shape=cylinder, style=filled, fillcolor="#FFD700", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#B8860B", penwidth=1.5];

        feature_store [label="Feature Store /\nModel Registry\n(UC Models + Distributions)", shape=cylinder, style="filled,dashed", fillcolor="#E0F2F1", fontname="Helvetica", fontsize=10, fontcolor="#333333", color="#00796B", penwidth=1.5];
    }

    // ===================================================================
    // EDGES
    // ===================================================================

    // App to Endpoint
    fastapi -> endpoint [color="#FF3621", penwidth=2, label="  SSE stream  "];

    // App embeds Genie directly
    genie_embed -> genie [color="#1B6ACB", penwidth=1.5, style=dashed, label=" iframe embed "];

    // Endpoint to Router
    endpoint -> router [color="#FF3621", penwidth=2, label="  user query  "];

    // Router to sub-agents
    router -> encounter_agent [color="#1B6ACB", penwidth=1.5, label=" historical "];
    router -> checker_agent [color="#E8820C", penwidth=1.5, label=" simulation "];
    router -> trigger_agent [color="#E8820C", penwidth=1.5, style=dashed, label=" if not_found "];
    router -> distribution_agent [color="#E8820C", penwidth=1.5, style=dashed, label=" catalog "];

    // Analytics flow
    encounter_agent -> genie [color="#1B6ACB", penwidth=1.5, lhead=cluster_analytics];
    metricviews -> hospital_tables [color="#2D8C3C", penwidth=1];

    // Simulation flow
    checker_agent -> check_fn [color="#E8820C", penwidth=1.5];
    trigger_agent -> trigger_fn [color="#E8820C", penwidth=1.5];
    distribution_agent -> list_dist_fn [color="#E8820C", penwidth=1.5];

    check_fn -> sim_runs [color="#2D8C3C", penwidth=1, label=" cache lookup "];
    check_fn -> sim_results [color="#B8860B", penwidth=1, label=" Gold results "];
    list_dist_fn -> dist_specs [color="#2D8C3C", penwidth=1];

    trigger_fn -> task1 [color="#E8820C", penwidth=1.5, style=dashed, label=" POST /jobs/run-now "];

    // Pipeline flow
    task1 -> task2 [color="#E8820C", penwidth=1.5];
    task2 -> task3 [color="#E8820C", penwidth=1.5];
    task2 -> sim_trials [color="#CD7F32", penwidth=1, label=" Bronze "];
    task3 -> sim_results [color="#B8860B", penwidth=1, label=" Gold "];
    task1 -> sim_runs [color="#2D8C3C", penwidth=1];
    task1 -> dist_specs [color="#2D8C3C", penwidth=1, style=dashed, label=" resolve "];

    // Genie reads Gold results
    genie -> sim_results [color="#B8860B", penwidth=1, style=dashed, label=" prior sim results "];

    // ===================================================================
    // AGENTIC LAYER EDGES (Future — dashed)
    // ===================================================================

    // Agentic layer tools feed from orchestration
    router -> python_exec [color="#00796B", penwidth=1.5, style=dashed, label=" execute code ", lhead=cluster_agentic];

    // Agentic tools read data via MCP
    mcp_tools -> hospital_tables [color="#00796B", penwidth=1, style=dashed, label=" read data "];
    mcp_tools -> sim_results [color="#00796B", penwidth=1, style=dashed];

    // Model builder contributes to simulation layer
    model_builder -> feature_store [color="#00796B", penwidth=2, style=dashed, label=" register models\n + distributions "];
    // Feature store feeds pipeline
    feature_store -> task1 [color="#00796B", penwidth=1, style=dashed, label=" load models "];
}
